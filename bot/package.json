{
  "name": "ec-sigma",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Sigma's dreamDEX Event Contract strategy: reads SigmaOracle's fair value, quantizes onto the venue's tick grid, places real orders, seeds empty books, and claims settled positions.",
  "scripts": {
    "test": "node --test src/*.test.mjs",
    "read": "node src/marketRead.mjs",
    "read:json": "node src/marketRead.mjs --json",
    "dry-run": "node run-dry-run.mjs",
    "dry-run:loop": "node run-dry-run.mjs --loop",
    "live": "node run-live.mjs --live",
    "live:loop": "node run-live.mjs --live --loop",
    "maker": "node run-live.mjs --live --maker",
    "maker:loop": "node run-live.mjs --live --maker --loop",
    "claim": "node run-live.mjs --claim"
  },
  "dependencies": {
    "@somnia-chain/markets-sdk": "0.28.1",
    "dotenv": "^16.4.7",
    "viem": "^2.56.0"
  }
}
