# Copy to .env and fill in. Never commit .env. Use a throwaway TESTNET key only.

# Signs every write script (deploy, price pusher, cron, auto-trade) and `bot --live`.
DEPLOYER_PRIVATE_KEY=

# Optional overrides
SOMNIA_TESTNET_RPC=https://dream-rpc.somnia.network
SIGMA_MIN_EDGE_BPS=200
SIGMA_MAX_STAKE=25
AUTO_CLAIM=false

# Separate trading key used by scripts/auto-trade.mjs and scripts/proof-of-work.mjs
PRIVATE_KEY=
